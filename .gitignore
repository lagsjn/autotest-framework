# 虚拟环境：体积大、平台相关，人人按 requirements.txt 自装
.venv/
# Python 与 pytest 缓存
__pycache__/
.pytest_cache/
# IDE 个人配置
.idea/
# 运行产物：日志、失败截图、allure 数据
log/
allure-results/
# Allure 静态报告：里面固化了运行时真值（接口日志的内网地址+端口、
# 参数化实参里的真实账号），只本地生成、本地演示，永不入库
allure-report/
# JUnit 汇总 XML（CI 产物用，本地跑完即丢）
junit-*.xml
# 敏感信息：真值永不见天日（昨天学的！）
.env
# 个人学习与内部文档：docs 整目录只存本地（学习笔记/SQL讲义/CI笔记/接口地图/用例文档），不公开
docs/
# PDF 一律不入库（兜底防其他目录混入）
*.pdf
# 直连公司真库的侦察/验证脚本：含真实表列名与真库数据，只存本地供压测待办复用
script/probe_perf_login_prep.py
script/sql_verify_mysql.py
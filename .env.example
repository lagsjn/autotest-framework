TEST_BASE_URL=https://your-target-system.example.com
TEST_USERNAME=your_test_account
TEST_PASSWORD=your_test_password
# 学生端（L5 跨端链路用，可选资源：不配则相关用例 skipif 跳过）
TEST_STUDENT_USERNAME=
TEST_STUDENT_PASSWORD=
# 学生端独立入口（同一系统不同端口，实测 2026-11-07）
TEST_STUDENT_BASE_URL=
# 废弃老师账号（negative/红级专用，可选资源）
TEST_RED_USERNAME=
TEST_RED_PASSWORD=
# TLS 证书校验总开关（全局唯一，测试环境专用）：
#   缺省/false = 关掉校验（自签证书内网测试环境，requests verify=False + Edge 忽略证书错误）；
#   true = 开启正规校验（需先把服务器证书导入系统受信任根、接口侧配 CA/证书路径，否则连不上）。
# 这是不安全操作的唯一授权位：绕过校验只允许用于隔离测试环境，严禁指向生产。
TEST_VERIFY_SSL=false